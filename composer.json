{
    "name": "kineticamobile/lumki",
    "description": "Laravel User Management for Laravel 13 with Jetstream",
    "license": "MIT",
    "authors": [
        {
            "name": "Raul Tierno",
            "email": "raultm@gmail.com",
            "homepage": "https://github.com/raultm"
        },
        {
            "name": "Daniel Macías",
            "email": "danielmaciasramos@gmail.com",
            "homepage": "https://github.com/dmaciasr"
        },
        {
            "name": "Emilio Ortiz",
            "email": "emilio.ortiz@kinetica.mobi",
            "homepage": "https://github.com/branigan"
        }
    ],
    "homepage": "https://github.com/kineticamobile/lumki",
    "keywords": [
        "Laravel",
        "Lumki",
        "Users Management",
        "Laravel 13"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "spatie/laravel-permission": "^8.0",
        "lab404/laravel-impersonate": "^1.7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kineticamobile\\Lumki\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kineticamobile\\Lumki\\LumkiServiceProvider"
            ],
            "aliases": {
                "Lumki": "Kineticamobile\\Lumki\\Facades\\Lumki"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    }
}
